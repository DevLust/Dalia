# Copie para .env e preencha com os dados do seu projeto Supabase.
# Nunca commite o arquivo .env (já está no .gitignore).
#
# Produção (Vercel): mesmas variáveis em Settings → Environment Variables + Redeploy.
# Login: crie usuários em Supabase → Authentication → Users e perfil em tabela usuarios.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui
